FROM python:3.12-slim

WORKDIR /app

# Core deps only. The image intentionally ships WITHOUT the heavy torch
# stack, so it builds in seconds. To bake the real model in, install
# requirements-ml.txt too and set ENABLE_HF_MODELS=true.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]