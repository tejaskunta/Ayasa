# model-service environment
# Copy to .env and fill in if needed:  cp .env.example .env

# Load the real Hugging Face model? "true" = transformer mode, "false" = rules_only.
# Default is false so the service always starts instantly and deterministically.
ENABLE_HF_MODELS=false

# Your model on Hugging Face.
STRESS_MODEL_NAME=ganeshtk/silentstress-model
STRESS_MODEL_SUBFOLDER=Complete_StressModel/bert_stress_model_final_2

# Only needed if the model repo is private.
HF_TOKEN=

# Optional: enables the conversational reply layer. Without it the server's
# deterministic safety/fallback replies are used (still fully functional).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant